{
  "name": "silver-skies-desktop",
  "version": "1.3.0",
  "description": "Silver Skies — desktop weather radar, forecast, and severe alert dashboard.",
  "author": {
    "name": "Silver Skies",
    "email": "e993372@staff.poliberry.com"
  },
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "install:renderer": "npm --prefix renderer install",
    "dev:renderer": "npm --prefix renderer run dev",
    "dev:electron": "tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "dev": "concurrently -k -n RENDERER,ELECTRON -c blue,magenta \"npm run dev:renderer\" \"npm run dev:electron:launch\"",
    "dev:electron:launch": "tsc -p electron/tsconfig.json && wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .",
    "build:renderer": "npm --prefix renderer run build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:renderer && npm run build:electron",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:publish": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "electron-serve": "^2.1.1",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.silverskies.desktop",
    "productName": "Silver Skies",
    "files": [
      "dist-electron/**/*",
      "renderer/out/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon-dark.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "assets/icon-dark.png",
      "category": "public.app-category.weather"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "assets/icon-dark.png",
      "category": "Utility",
      "maintainer": "Silver Skies <e993372@staff.poliberry.com>"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "poliberry",
        "repo": "silverskies-desktop",
        "releaseType": "release"
      }
    ]
  }
}
